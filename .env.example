# ===== BrewLite - biến môi trường mẫu =====
# Sao chép thành .env (root, dùng cho docker compose) và apps/api/.env (chạy API local).
# KHÔNG commit file .env thật. Secret production được lưu trong GitHub Secrets / Render Environment.

# --- PostgreSQL ---
POSTGRES_USER=brewlite
POSTGRES_PASSWORD=brewlite
POSTGRES_DB=brewlite
DATABASE_URL=postgresql://brewlite:brewlite@localhost:5432/brewlite?schema=public

# --- API (NestJS) ---
PORT=3001
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:3000
# Mock payment gateway: độ trễ giả lập (ms) và tỉ lệ lỗi ngẫu nhiên (0..1)
PAYMENT_LATENCY_MS=300
PAYMENT_FAILURE_RATE=0
# Chạy migration / seed khi container khởi động
RUN_MIGRATIONS=true
SEED_ON_START=true

# --- Web (Next.js) ---
# URL nội bộ mà route proxy /api/* của Next.js dùng để gọi NestJS
API_INTERNAL_URL=http://localhost:3001
